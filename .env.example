# SOSPHD — environment template
#
# Copy to `.env.local` (gitignored) and fill in. Every variable the codebase
# reads is listed here; there are no others.
#
#   cp .env.example .env.local
#
# ─────────────────────────────────────────────────────────────────────────────
# Supabase — required. Without these the app boots but every read logs
# [SOSPHD:DEGRADED] and returns empty/seed data instead of failing loudly.
# ─────────────────────────────────────────────────────────────────────────────

# Project ref jnbxkvlkqmwnqlmetknj — the SHARED Tourist SOS database.
# SOSPHD owns the `research.*` schema only and is read-only against `public.*`
# (see CLAUDE.md → Database Boundaries). More than one Supabase project exists
# in this account; pointing at the wrong one would corrupt another app's data.
NEXT_PUBLIC_SUPABASE_URL=https://jnbxkvlkqmwnqlmetknj.supabase.co

# Anon key ONLY. There is deliberately no SUPABASE_SERVICE_ROLE_KEY in this
# codebase — every table has RLS, user-scoped tables gate on auth.uid(), and
# the shared research spine gates on research.allowed_users (SD-001). A service
# role key here would bypass all of it. Do not add one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AI — required for /advisor, /dashboard/paper-builder, recommendation
# generation and the docs assistant. The rest of the app works without it;
# those surfaces throw MissingAIKeyError with a clear message.
# ─────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=

# Model routing (lib/ai/config.ts). All optional — omit and every surface uses
# the built-in default. Per-surface overrides exist so Paper 2 can compare
# engines without touching code. Resolution order is:
#   SOSPHD_MODEL_<SURFACE>  →  SOSPHD_MODEL_DEFAULT  →  built-in default
#
# Note these per-surface names are constructed at runtime from the surface id,
# so grepping the source for them finds nothing. This list is the real set.
# SOSPHD_MODEL_DEFAULT=
# SOSPHD_MODEL_RECOMMENDATIONS=
# SOSPHD_MODEL_ADVISOR=
# SOSPHD_MODEL_PAPER_BUILDER=
# SOSPHD_MODEL_DOC_ASSISTANT=
# SOSPHD_MODEL_CATEGORIZE=

# ─────────────────────────────────────────────────────────────────────────────
# Local development only
# ─────────────────────────────────────────────────────────────────────────────

# Where Supabase sends the sign-up confirmation link. Unset, sign-up uses
# `${window.location.origin}/spine`, which is correct in every deployed
# environment. Set it only when the origin the browser sees is not the origin
# Supabase can reach back to — e.g. a tunnel or a non-standard dev port.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/spine
